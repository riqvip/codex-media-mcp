# Put the key here, never in Codex's prompt or the repository.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Optional separate audio model. Empty means use OPENROUTER_MODEL.
OPENROUTER_AUDIO_MODEL=
# Optional provider/endpoint slug; empty allows OpenRouter routing.
# Pinning disables provider fallback. Example for Gemini: google-ai-studio.
OPENROUTER_PROVIDER=
# default leaves the provider's thinking policy unchanged. Model support varies.
# none disables thinking on compatible models; low requests a smaller effort.
MEDIA_REASONING_EFFORT=default
# Optional positive thinking-token budget on compatible models. Keep effort=default
# when using this budget; effort and token budgets are mutually exclusive.
MEDIA_REASONING_MAX_TOKENS=

# Docker publishes this port only on the WSL loopback interface.
MEDIA_MCP_PORT=8766

# Long requests are physically split into these lengths (seconds).
MEDIA_SEGMENT_SECONDS=300
MEDIA_MAX_SEGMENTS=12
MEDIA_MAX_UPLOAD_MB=32
MEDIA_MAX_SOURCE_GB=8
MEDIA_MAX_OUTPUT_TOKENS=8000
MEDIA_PROVIDER_TIMEOUT_SECONDS=240
MEDIA_CALL_TIMEOUT_SECONDS=900
MEDIA_FFMPEG_TIMEOUT_SECONDS=180
# Local inspect_media scans have their own timeout and bounded interval output.
MEDIA_INSPECT_TIMEOUT_SECONDS=900
MEDIA_INSPECT_MAX_INTERVALS=100
# Video normalization: preserve audio, at most 1920px on the longest edge,
# at most 2fps, H.264 CRF 23. This is reported with every analysis.
MEDIA_VIDEO_MAX_EDGE=1920
MEDIA_VIDEO_MAX_FPS=2
MEDIA_VIDEO_CRF=23
